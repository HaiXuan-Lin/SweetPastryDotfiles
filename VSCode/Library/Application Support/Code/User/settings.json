{
  // >>> VSCode Formatter >>>
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "[python]": {
    "editor.defaultFormatter": "njpwerner.autodocstring"
  },
  "[latex]": {
    "editor.defaultFormatter": "nickfode.latex-formatter"
  },
  "notebook.defaultFormatter": "njpwerner.autodocstring",
  // <<< VSCode Formatter <<<
  // >>> VSCode Security, Workspace Trust >>>
  "security.workspace.trust.enabled": true, // Ask for trust confirmation when opening untrusted folders
  "security.workspace.trust.untrustedFiles": "open",
  // <<< VSCode Security, Workspace Trust <<<
  // >>> VSCode Workbench >>>
  "workbench.colorCustomizations": {
    "editorCursor.foreground": "#FFFFFF",
    "editorCursor.background": "#FFFFFF"
  },
  "workbench.editor.empty.hint": "hidden", // Hide hints displayed in empty editor area
  // "workbench.editor.enablePreview": false, // Disable preview mode, create perminent tab when opening file
  "workbench.editor.scrollToSwitchTabs": true,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.layoutControl.enabled": false, // Hide layout control bottom
  "workbench.list.horizontalScrolling": true, // Enables horizontal scrolling in lists (e.g., for long filenames)
  "workbench.list.smoothScrolling": true,
  "workbench.panel.opensMaximized": "always", // Controls how the bottom panel (terminal/output) opens: "always" = maximized
  "workbench.settings.applyToAllProfiles": [
    "terminal.integrated.cursorStyle",
    "terminal.integrated.cursorStyleInactive"
  ], // Specifies which settings should apply to all profiles (empty array = none)
  "workbench.startupEditor": "none", // Specifies what editor to show on startup ("none" = show empty workspace)
  "workbench.statusBar.visible": false,
  "workbench.editorAssociations": {
    "*.exe": "default",
    "*.PDF": "latex-workshop-pdf-hook",
    "*.pdf": "latex-workshop-pdf-hook",
    "*.md": "default"
  },
  "editor.autoClosingBrackets": "beforeWhitespace",
  "editor.autoClosingDelete": "always",
  "editor.autoClosingOvertype": "always",
  "editor.autoClosingQuotes": "beforeWhitespace",
  "editor.bracketPairColorization.enabled": true,
  "editor.cursorBlinking": "expand",
  "editor.cursorSmoothCaretAnimation": "explicit",
  "editor.fontFamily": "FiraCode Nerd Font Mono, JetBrainsMonoNL Nerd Font Mono",
  "editor.fontLigatures": false, // Disables fancy character combinations (e.g., => as single glyph)
  "editor.fontSize": 16,
  "editor.fontWeight": "bold",
  "editor.guides.bracketPairs": true,
  "editor.lineHeight": 1.5,
  "editor.minimap.size": "fit",
  "editor.minimap.enabled": true, // the minimap (code overview sidebar)
  "editor.mouseWheelZoom": true,
  "editor.smoothScrolling": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.suggestSelection": "recentlyUsedByPrefix",
  "editor.wordWrap": "on",
  "editor.tokenColorCustomizations": {
    "[*Light*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#000"
          }
        }
      ]
    },
    "[*Dark*]": {
      "textMateRules": [
        {
          "scope": "ref.matchtext",
          "settings": {
            "foreground": "#fff"
          }
        }
      ]
    },
    "textMateRules": [
      {
        "name": "One Dark italic",
        "scope": [
          "comment",
          "entity.other.attribute-name",
          "keyword",
          "markup.underline.link",
          "storage.modifier",
          "storage.type",
          "string.url",
          "variable.language.super",
          "variable.language.this"
        ],
        "settings": {
          "fontStyle": "italic"
        }
      },
      {
        "name": "One Dark italic reset",
        "scope": [
          "keyword.operator",
          "keyword.other.type",
          "storage.modifier.import",
          "storage.modifier.package",
          "storage.type.built-in",
          "storage.type.function.arrow",
          "storage.type.generic",
          "storage.type.java",
          "storage.type.primitive"
        ],
        "settings": {
          "fontStyle": ""
        }
      }
    ]
  },
  // <<< VSCode Editor <<<
  // >>> VSCode Files >>>
  "files.autoGuessEncoding": true,
  "files.autoSave": "afterDelay",
  "files.associations": {
    "*.rmd": "markdown"
  },
  // <<< VSCode Files <<<
  // >>> VSCode Explorer >>>
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "explorer.fileNesting.enabled": true,
  "terminal.integrated.commandsToSkipShell": [
    "matlab.interrupt"
  ],
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorStyleInactive": "block",
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.fontFamily": "JetBrainsMonoNL Nerd Font Mono,  FiraCode Nerd Font Mono",
  "terminal.integrated.fontSize": 20,
  "terminal.integrated.fontWeight": "bold",
  "terminal.integrated.gpuAcceleration": "off",
  "terminal.integrated.macOptionIsMeta": true,
  "terminal.integrated.smoothScrolling": true,
  // <<< VSCode Terminal <<<
  // >>> VSCode Animations >>>
  "custom-ui-style.external.imports": [
    "file:///Users/Lin/.vscode/extensions/brandonkirbyson.vscode-animations-2.0.8/dist/updateHandler.js"
  ],
  "animations.CursorAnimation": true,
  "animations.Install-Method": "Custom CSS and JS",
  "animations.UseCursorColorForCursorAnimation": true,
  "animations.CursorAnimationOptions": {
    "TrailLength": 4
  },
  // <<< VSCode Animation <<<
  // >>> VSCode Remote >>>
  "remoteHub.commitDirectlyWarning": "off",
  "remote.SSH.showLoginTerminal": true,
  "remote.SSH.useExecServer": false,
  "remote.SSH.remotePlatform": {
    "10.26.0.253": "linux",
    "10.26.0.251": "linux",
    "10.26.0.191": "linux",
    "10.26.3.46": "linux",
    "10.26.0.254": "linux"
  },
  // <<< VSCode Remote <<<
  // >>> VSCode Other Naive Settings >>>
  "diffEditor.ignoreTrimWhitespace": true,
  "diffEditor.hideUnchangedRegions.enabled": true,
  "window.titleBarStyle": "custom",
  "window.dialogStyle": "custom",
  "javascript.format.semicolons": "remove",
  "typescript.format.semicolons": "remove",
  "launch": {},
  // <<< VSCode Other Naive Settings <<<
  // >>> LaTeX WorkShop >>>
  "latex-workshop.showContextMenu": true,
  "latex-workshop.intellisense.package.enabled": true,
  "latex-workshop.message.error.show": false,
  "latex-workshop.message.warning.show": false,
  "latex-workshop.hover.command.enabled": true,
  "latex-workshop.hover.citation.enabled": true,
  "latex-workshop.hover.preview.cursor.enabled": true,
  "latex-workshop.hover.preview.enabled": true,
  "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.view.pdf.external.synctex.command": "/Applications/Skim.app/Contents/SharedSupport/displayline", // MacOS Skim PDF
  "latex-workshop.view.pdf.external.synctex.args": [
    "-r",
    "%LINE%",
    "%PDF%",
    "%TEX%"
  ],
  "latex-workshop.view.pdf.external.viewer.command": "/Applications/Skim.app/Contents/SharedSupport/displayline",
  "latex-workshop.view.pdf.external.viewer.args": [
    "0",
    "%PDF%",
  ],
  "latex-workshop.latex.autoBuild.run": "never",
  "latex-workshop.latex.autoClean.run": "onFailed",
  "latex-workshop.latex.clean.method": "glob",
  "latex-workshop.latex.recipe.default": "lastUsed",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk (-pdf)",
      "command": "latexmk",
      "args": [
        "-pdf",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "--shell-escape",
        "%DOC%"
      ]
    },
    {
      "name": "latexmk (-xelatex)",
      "command": "latexmk",
      "args": [
        "-xelatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "--shell-escape",
        "%DOC%"
      ]
    },
    {
      "name": "latexmk (-lualatex)",
      "command": "latexmk",
      "args": [
        "-lualatex",
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "--shell-escape",
        "%DOC%"
      ]
    },
    {
      "name": "pdflatex",
      "command": "pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "--shell-escape",
        "%DOC%"
      ]
    },
    {
      "name": "xelatex",
      "command": "xelatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "--shell-escape",
        "%DOC%"
      ]
    },
    {
      "name": "bibtex",
      "command": "bibtex",
      "args": [
        "%DOCFILE%"
      ]
    },
    {
      "name": "biber",
      "command": "biber",
      "args": [
        "%DOCFILE%"
      ]
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "latexmk (-pdf)",
      "tools": [
        "latexmk (-pdf)"
      ]
    },
    {
      "name": "latexmk (-xelatex)",
      "tools": [
        "latexmk (-xelatex)"
      ]
    },
    {
      "name": "latexmk (-lualatex)",
      "tools": [
        "latexmk (-lualatex)"
      ]
    },
    {
      "name": "XeLaTeX",
      "tools": [
        "xelatex"
      ]
    },
    {
      "name": "PDFLaTeX",
      "tools": [
        "pdflatex"
      ]
    },
    {
      "name": "BibTeX",
      "tools": [
        "bibtex"
      ]
    },
    {
      "name": "Biber",
      "tools": [
        "biber"
      ]
    },
    {
      "name": "xelatex",
      "tools": [
        "xelatex"
      ]
    },
    {
      "name": "xelatex -> bibtex -> xelatex*2",
      "tools": [
        "xelatex",
        "bibtex",
        "xelatex",
        "xelatex"
      ]
    },
    {
      "name": "pdflatex -> bibtex -> pdflatex*2",
      "tools": [
        "pdflatex",
        "bibtex",
        "pdflatex",
        "pdflatex"
      ]
    },
    {
      "name": "xelatex -> biber -> xelatex*2",
      "tools": [
        "xelatex",
        "biber",
        "xelatex",
        "xelatex"
      ]
    },
    {
      "name": "pdflatex -> biber -> pdflatex*2",
      "tools": [
        "pdflatex",
        "biber",
        "pdflatex",
        "pdflatex"
      ]
    }
  ],
  "latex-workshop.latex.clean.fileTypes": [
    "*.aux",
    "*.bbl",
    "*.blg",
    "*.bcf",
    "*.idx",
    "*.ind",
    "*.lof",
    "*.lot",
    "*.out",
    "*.toc",
    "*.acn",
    "*.acr",
    "*.alg",
    "*.glg",
    "*.glo",
    "*.gls",
    "*.ist",
    "*.fls",
    "*.log",
    "*.fdb_latexmk",
    "*.dvi",
    "*.synctex.gz",
    "*.gz",
    "*.bcf-SAVE-ERROR",
    "*.run.xml",
    "*.pdf"
  ],
  // <<< LaTeX WorkShop <<<
  // >>> Code Runner >>>
  "code-runner.runInTerminal": true,
  "code-runner.saveAllFilesBeforeRun": true,
  // <<< Code Runner <<<
