	"Div 高亮块（带光标）": {
		"prefix": "div",
		"body": [
			"<div style=\"background-color: #3E4E56; padding: 10px; border-left: 5px solid #007acc; color: white;\">",
			"\t$1",
			"</div>"
		],
		"description": "插入高亮 div 框并将光标移至中间"
	}
}